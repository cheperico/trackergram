# Configuración Apache para trackerGram

# Límites de PHP para importación de archivos grandes
# upload_max_filesize / post_max_size: debe coincidir con el ZIP más grande que subas (200MB+)
php_value upload_max_filesize 200M
php_value post_max_size 200M
php_value memory_limit 1024M
php_value max_execution_time 0
php_value max_input_time -1

# Deshabilitar listado de directorios
Options -Indexes

# Evitar acceso a archivos sensibles
<Files "config.php">
    Require all denied
</Files>

<Files "*.json">
    Require all denied
</Files>

<Files ".env">
    Require all denied
</Files>

<Files ".env.example">
    Require all denied
</Files>

<Files "*.log">
    Require all denied
</Files>

<Files "*.md">
    Require all denied
</Files>

<Files "*.sql">
    Require all denied
</Files>

# setup_webhook.php y admin.php requieren autenticación propia
# No se bloquean en .htaccess para permitir acceso administrativo

# Forzar HTTPS (redirigir todo HTTP a HTTPS)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Headers de seguridad HTTP
<IfModule mod_headers.c>
    # Protección contra clickjacking
    Header set X-Frame-Options "DENY"
    
    # Evitar MIME sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Protección XSS
    Header set X-XSS-Protection "1; mode=block"
    
    # Política de referer
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Content-Security-Policy
    # 'unsafe-inline' necesario para admin.php (inline scripts + styles).
    # Ideal futuro: mover JS a archivos externos con nonce/hash.
    # - object-src 'none' bloquea Flash/plugins
    # - base-uri 'self' evita injection de base tags
    # - form-action 'self' restringe destinos de formularios
    Header set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self';"
</IfModule>
