# trackerGram - Variables de Entorno (Plantilla)
# Copiar este archivo a .env y configurar los valores reales
#
# NOTA: Las credenciales de bots, wikis y trackers se configuran
# desde el panel de administración y se persisten en config/setup.json.
# El .env solo contiene configuración GLOBAL de la aplicación.

# ============================================================
# AUTENTICACIÓN DEL PANEL DE ADMINISTRACIÓN
# ============================================================

# Usuario y contraseña para acceder a admin.php
# La contraseña debe ser un hash bcrypt generado con password_hash()
ADMIN_USERNAME=admin
ADMIN_PASSWORD=$2y$10$...hash...

# ============================================================
# CONFIGURACIÓN GLOBAL DE LA APLICACIÓN
# ============================================================

# Modo debug (true solo para debugging)
DEBUG_MODE=false

# Procesamiento asíncrono de webhooks (default global)
# true: api.php encola eventos, worker.php los procesa (requiere cron)
# false: api.php procesa sincrónicamente (default)
# Se puede sobrescribir por conexión desde el panel admin.
ASYNC_PROCESSING=false

# URL personalizada del webhook (opcional)
# Si está vacía, api.php calcula la URL automáticamente desde $_SERVER.
CUSTOM_WEBHOOK_URL=

# ============================================================
# FILTRO GLOBAL DE CHATS (opcional)
# ============================================================
# IDs de chats permitidos, separados por coma.
# Vacío = procesar todos los chats (si tienen conexión configurada).
# Cada conexión ya tiene su propio chat_id en setup.json.
# ALLOWED_CHAT_IDS=-100123456789,-100987654321
