# trackerGram - Variables de Entorno (Plantilla)
# Copiar este archivo a .env y configurar los valores reales

# Token del bot de Telegram (obtenido de @BotFather)
TELEGRAM_BOT_TOKEN=tu_token_aqui

# Secret token para webhook de Telegram (opcional pero recomendado)
# Genera un token aleatorio largo y seguro
TELEGRAM_WEBHOOK_SECRET=tu_token_secreto_webhook_aqui

# Configuración de TikiWiki
TIKIWIKI_API_URL=http://localhost/tikigram/api/
TIKIWIKI_TOKEN=tu_token_tikiwiki_aqui
TIKIWIKI_TRACKER_ID=1

# Credenciales para interfaz de administración
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar_esta_contraseña

# Configuración de la aplicación
DEBUG_MODE=false
